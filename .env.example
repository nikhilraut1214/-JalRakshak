# Database (Local SQLite default, or Managed PostgreSQL)
DATABASE_URL=sqlite:///./jalrakshak.db
# DATABASE_URL=postgresql://jalrakshak:jalrakshak_password@localhost:5432/jalrakshak_db

# Supabase Auth Configuration (Server-side JWT verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# Groq API Configuration (Server-side explanation only; deterministic fallback is active if empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Analytics Parameters
LOSS_REFERENCE_LITERS=1000.0
TREND_NORMALIZATION_FACTOR=50.0
